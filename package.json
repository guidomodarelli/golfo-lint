{
  "name": "@golfo/lint",
  "version": "0.0.0",
  "description": "Reglas de calidad de código para agentes de IA: ESLint, Stylelint, jscpd, knip, lizard, dependency-cruiser, react-doctor, publint, attw, actionlint, zizmor, gitleaks y sherif, sin reglas de formato.",
  "type": "module",
  "license": "MIT",
  "author": "Guido Modarelli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidomodarelli/golfo-lint.git"
  },
  "homepage": "https://github.com/guidomodarelli/golfo-lint#readme",
  "bugs": "https://github.com/guidomodarelli/golfo-lint/issues",
  "keywords": [
    "ai-agents",
    "code-quality",
    "dependency-cruiser",
    "eslint",
    "eslint-config",
    "gitleaks",
    "jscpd",
    "knip",
    "lizard",
    "publint",
    "react-doctor",
    "stylelint",
    "zizmor"
  ],
  "bin": {
    "golfo-lint": "./bin/golfo-lint.js"
  },
  "exports": {
    "./eslint": {
      "types": "./src/eslint/index.d.ts",
      "default": "./src/eslint/index.js"
    },
    "./jscpd": {
      "types": "./src/jscpd/index.d.ts",
      "default": "./src/jscpd/index.js"
    },
    "./knip": {
      "types": "./src/knip/index.d.ts",
      "default": "./src/knip/index.js"
    },
    "./lizard": {
      "types": "./src/lizard/index.d.ts",
      "default": "./src/lizard/index.js"
    },
    "./stylelint": {
      "types": "./src/stylelint/index.d.ts",
      "default": "./src/stylelint/index.js"
    },
    "./dependency-cruiser": {
      "types": "./src/dependency-cruiser/index.d.ts",
      "default": "./src/dependency-cruiser/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "pack:check": "npm pack --dry-run",
    "check:packed-install": "node scripts/check-packed-install.mjs",
    "ci": "npm run lint && npm run typecheck && npm test && npm run pack:check",
    "create-version": "golfo-rp create-version",
    "cv": "golfo-rp create-version",
    "prepublishOnly": "golfo-rp guard-publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "eslint": "^10.4.0",
    "react-doctor": "^0.9.18"
  },
  "peerDependenciesMeta": {
    "react-doctor": {
      "optional": true
    }
  },
  "dependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.1",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.7.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.13.0",
    "jscpd": "5.4.2",
    "knip": "6.42.1",
    "publint": "0.3.25",
    "sherif": "1.13.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "devDependencies": {
    "@golfo/rp": "2.0.0",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "react-doctor": "0.9.18"
  }
}
