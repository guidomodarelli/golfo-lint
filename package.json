{
  "name": "@golfo/lint",
  "version": "0.0.0",
  "description": "Reglas de calidad de código compartidas: ESLint sin reglas de formato, duplicación con jscpd, código muerto con knip y complejidad con lizard.",
  "type": "module",
  "license": "MIT",
  "author": "Guido Modarelli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidomodarelli/golfo-lint.git"
  },
  "homepage": "https://github.com/guidomodarelli/golfo-lint#readme",
  "bugs": "https://github.com/guidomodarelli/golfo-lint/issues",
  "keywords": [
    "eslint",
    "eslint-config",
    "jscpd",
    "knip",
    "lizard",
    "code-quality"
  ],
  "bin": {
    "golfo-lint": "./bin/golfo-lint.js"
  },
  "exports": {
    "./eslint": {
      "types": "./src/eslint/index.d.ts",
      "default": "./src/eslint/index.js"
    },
    "./jscpd": {
      "types": "./src/jscpd/index.d.ts",
      "default": "./src/jscpd/index.js"
    },
    "./knip": {
      "types": "./src/knip/index.d.ts",
      "default": "./src/knip/index.js"
    },
    "./lizard": {
      "types": "./src/lizard/index.d.ts",
      "default": "./src/lizard/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "pack:check": "npm pack --dry-run",
    "ci": "npm run lint && npm run typecheck && npm test && npm run pack:check",
    "create-version": "golfo-rp create-version",
    "cv": "golfo-rp create-version",
    "prepublishOnly": "golfo-rp guard-publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "eslint": "^10.4.0"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^78.0.0",
    "globals": "^17.13.0",
    "jscpd": "^5.4.2",
    "knip": "^6.42.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "devDependencies": {
    "@golfo/rp": "^2.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0"
  }
}
