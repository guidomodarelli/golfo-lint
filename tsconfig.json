{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["bin", "src", "test", "types", "eslint.config.js", "knip.config.js", "golfo-rp.config.js"],
  "exclude": ["test/fixtures"]
}
